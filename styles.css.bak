/* ==========================================================================
   PERSONALIZED LEARNING RECOMMENDATION SYSTEM - VIBRANT & COLORFUL DESIGN SYSTEM
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap');

/* Color Variables & Theme System */
:root {
  --font-main: 'Inter', system-ui, -apple-system, sans-serif;
  --font-heading: 'Outfit', sans-serif;
  
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-full: 9999px;

  --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-bounce: 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);

  --primary-500: #be185d;
  --primary-600: #9d174d;
  --primary-gradient: linear-gradient(135deg, #9d174d 0%, #be185d 50%, #db2777 100%);

  --color-indigo: #be185d;
  --color-purple: #9d174d;
  --color-pink: #db2777;
  --color-rose: #ef4444;
  --color-amber: #475569;
  --color-emerald: #10b981;
  --color-cyan: #db2777;
  --color-blue: #be185d;

  --gradient-blue-cyan: linear-gradient(135deg, #475569, #be185d);
  --gradient-purple-pink: linear-gradient(135deg, #9d174d, #db2777);
  --gradient-amber-rose: linear-gradient(135deg, #3f3f46, #be185d);
  --gradient-emerald-teal: linear-gradient(135deg, #10b981, #0f766e);
}

/* --------------------------------------------------------------------------
   LIGHT THEME: Crisp White Background + Ultra Colorful Elements
   -------------------------------------------------------------------------- */
[data-theme="light"] {
  --bg-page: #ffffff;
  --bg-surface: #ffffff;
  --bg-card: #f8fafc;
  --bg-card-hover: #f1f5f9;
  --bg-sidebar: #f8fafc;
  --bg-navbar: rgba(255, 255, 255, 0.9);
  --bg-modal: #ffffff;

  --text-main: #0f172a;
  --text-muted: #64748b;
  --text-subtle: #94a3b8;

  --border-color: #e2e8f0;
  --border-highlight: rgba(190, 24, 93, 0.25);
  
  --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
  --shadow-md: 0 8px 24px rgba(190, 24, 93, 0.08);
  --shadow-lg: 0 16px 36px rgba(190, 24, 93, 0.12);
  --shadow-colorful: 0 12px 30px rgba(157, 23, 77, 0.18);
}

/* --------------------------------------------------------------------------
   DARK THEME: Deep Rich Colorful Space Background + Neon Glassmorphism
   -------------------------------------------------------------------------- */
[data-theme="dark"] {
  --bg-page: #090d16;
  --bg-surface: #0f172a;
  --bg-card: rgba(15, 23, 42, 0.75);
  --bg-card-hover: rgba(30, 41, 59, 0.85);
  --bg-sidebar: rgba(11, 15, 25, 0.95);
  --bg-navbar: rgba(9, 13, 22, 0.85);
  --bg-modal: #0f172a;

  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --text-subtle: #64748b;

  --border-color: rgba(255, 255, 255, 0.1);
  --border-highlight: rgba(157, 23, 77, 0.4);

  --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.2);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.6);
  --shadow-colorful: 0 12px 35px rgba(157, 23, 77, 0.35);
}

/* Reset & Base Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-main);
  background-color: var(--bg-page);
  color: var(--text-main);
  line-height: 1.5;
  transition: background-color var(--transition-normal), color var(--transition-normal);
  overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 700;
  letter-spacing: -0.02em;
}

button {
  font-family: var(--font-main);
  cursor: pointer;
  border: none;
  background: none;
  outline: none;
  transition: all var(--transition-fast);
}

input, select, textarea {
  font-family: var(--font-main);
}

/* App Layout Grid */
#app {
  display: flex;
  min-height: 100vh;
}

/* Sidebar Navigation */
.sidebar {
  width: 290px;
  background-color: var(--bg-sidebar);
  border-right: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  padding: 20px 16px;
  transition: transform var(--transition-normal);
  overflow-y: auto;
}

/* Custom sleek scrollbar for sidebar navigation */
.sidebar::-webkit-scrollbar {
  width: 5px;
}
.sidebar::-webkit-scrollbar-track {
  background: transparent;
}
.sidebar::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: var(--radius-full);
}
.sidebar::-webkit-scrollbar-thumb:hover {
  background: var(--color-purple);
}

.brand-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 12px 24px 12px;
}

.brand-icon {
  width: 42px;
  height: 42px;
  border-radius: var(--radius-md);
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  box-shadow: var(--shadow-colorful);
}

.brand-title {
  font-size: 1.15rem;
  font-weight: 800;
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.nav-section-label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-subtle);
  margin: 16px 12px 8px 12px;
}

.nav-menu {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.nav-item button {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-muted);
  white-space: nowrap;
}

.nav-item button:hover {
  background-color: var(--bg-card-hover);
  color: var(--primary-500);
  transform: translateX(4px);
}

.nav-item.active button {
  background: var(--primary-gradient);
  color: #ffffff !important;
  box-shadow: var(--shadow-colorful);
}

.nav-item .badge-count {
  margin-left: auto;
  background: rgba(255, 255, 255, 0.2);
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
}

/* User Account Quick Switcher Pill */
.sidebar-user-card {
  margin-top: auto;
  padding: 12px;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  gap: 10px;
}

.user-avatar {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-full);
  object-fit: cover;
  border: 2px solid var(--color-purple);
}

.user-info {
  flex: 1;
  overflow: hidden;
}

.user-name {
  font-weight: 700;
  font-size: 0.85rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-role {
  font-size: 0.75rem;
  color: var(--text-muted);
  text-transform: capitalize;
}

/* Main Content Wrapper */
.main-wrapper {
  margin-left: 290px;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* Top Navbar */
.navbar {
  height: 70px;
  background-color: var(--bg-navbar);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  position: sticky;
  top: 0;
  z-index: 90;
}

.nav-search {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  padding: 8px 16px;
  border-radius: var(--radius-full);
  width: 340px;
  transition: all var(--transition-fast);
}

.nav-search:focus-within {
  border-color: var(--color-purple);
  box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
}

.nav-search input {
  border: none;
  background: none;
  outline: none;
  color: var(--text-main);
  width: 100%;
  font-size: 0.9rem;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 14px;
}

.theme-toggle-btn, .icon-btn {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-full);
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-main);
}

.theme-toggle-btn:hover, .icon-btn:hover {
  background: var(--bg-card-hover);
  color: var(--primary-500);
  transform: scale(1.05);
}

.role-switcher-btn {
  padding: 6px 14px;
  border-radius: var(--radius-full);
  background: var(--gradient-purple-pink);
  color: #ffffff;
  font-size: 0.82rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6px;
  box-shadow: var(--shadow-sm);
}

.role-switcher-btn:hover {
  opacity: 0.9;
  transform: translateY(-1px);
}

/* Page Container */
.page-container {
  padding: 32px;
  max-width: 1350px;
  margin: 0 auto;
  width: 100%;
}

/* Banner & Headers */
.page-header {
  margin-bottom: 28px;
}

.page-title {
  font-size: 1.85rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 12px;
}

.page-subtitle {
  color: var(--text-muted);
  font-size: 0.95rem;
  margin-top: 4px;
}

/* Welcome Hero Card */
.hero-card {
  background: var(--primary-gradient);
  border-radius: var(--radius-lg);
  padding: 32px;
  color: #ffffff;
  position: relative;
  overflow: hidden;
  margin-bottom: 32px;
  box-shadow: var(--shadow-colorful);
}

.hero-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -10%;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 650px;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.22);
  padding: 4px 12px;
  border-radius: var(--radius-full);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  margin-bottom: 12px;
  backdrop-filter: blur(4px);
}

.hero-title {
  font-size: 2rem;
  font-weight: 800;
  line-height: 1.25;
  margin-bottom: 8px;
}

.hero-subtitle {
  font-size: 0.98rem;
  opacity: 0.92;
  margin-bottom: 20px;
}

.hero-actions {
  display: flex;
  gap: 12px;
}

.btn-hero-primary {
  background: #ffffff;
  color: var(--primary-600);
  font-weight: 700;
  padding: 10px 22px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
}

.btn-hero-primary:hover {
  transform: translateY(-2px);
  background: #f8fafc;
}

.btn-hero-secondary {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-weight: 600;
  padding: 10px 20px;
  border-radius: var(--radius-full);
  backdrop-filter: blur(4px);
}

.btn-hero-secondary:hover {
  background: rgba(255, 255, 255, 0.3);
}

/* Stats Overview Grid */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-bottom: 32px;
}

.stat-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  position: relative;
  overflow: hidden;
}

.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
  border-color: var(--border-highlight);
}

.stat-icon-wrapper {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 1.3rem;
  flex-shrink: 0;
}

.stat-card.blue .stat-icon-wrapper { background: var(--gradient-blue-cyan); }
.stat-card.purple .stat-icon-wrapper { background: var(--gradient-purple-pink); }
.stat-card.amber .stat-icon-wrapper { background: var(--gradient-amber-rose); }
.stat-card.emerald .stat-icon-wrapper { background: var(--gradient-emerald-teal); }

.stat-value {
  font-size: 1.6rem;
  font-weight: 800;
  font-family: var(--font-heading);
  line-height: 1.1;
}

.stat-label {
  font-size: 0.85rem;
  color: var(--text-muted);
  font-weight: 500;
}

/* Main Section Split Grid */
.section-grid-2-1 {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 28px;
  margin-bottom: 32px;
}

/* Section Header */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.section-title {
  font-size: 1.25rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 8px;
}

.section-link {
  color: var(--color-purple);
  font-size: 0.88rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 4px;
}

.section-link:hover {
  text-decoration: underline;
}

/* Vibrant Resource Cards */
.resource-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 22px;
}

.resource-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 20px;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: all var(--transition-normal);
}

.resource-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-colorful);
  border-color: var(--color-purple);
}

.resource-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.ai-match-badge {
  background: var(--gradient-purple-pink);
  color: #ffffff;
  font-size: 0.75rem;
  font-weight: 800;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  gap: 4px;
  box-shadow: 0 2px 8px rgba(236, 72, 153, 0.3);
}

.format-badge {
  text-transform: capitalize;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  background: var(--bg-card-hover);
  color: var(--text-muted);
}

.resource-title {
  font-size: 1.05rem;
  font-weight: 700;
  margin-bottom: 8px;
  line-height: 1.35;
}

.resource-desc {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-bottom: 16px;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.resource-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 0.8rem;
  color: var(--text-subtle);
  margin-bottom: 16px;
}

.resource-meta-item {
  display: flex;
  align-items: center;
  gap: 4px;
}

.resource-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 16px;
}

.tag-pill {
  font-size: 0.72rem;
  background: rgba(190, 24, 93, 0.1);
  color: var(--color-indigo);
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  font-weight: 600;
}

.resource-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: auto;
}

.btn-launch-resource {
  flex: 1;
  background: var(--primary-gradient);
  color: #ffffff;
  font-size: 0.88rem;
  font-weight: 700;
  padding: 8px 16px;
  border-radius: var(--radius-md);
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.btn-launch-resource:hover {
  box-shadow: var(--shadow-colorful);
  transform: scale(1.02);
}

.btn-bookmark {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
  background: var(--bg-card);
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-bookmark.active {
  background: rgba(245, 158, 11, 0.15);
  color: var(--color-amber);
  border-color: var(--color-amber);
}

/* Sidebar Widgets: Daily Goal & Streak */
.widget-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 22px;
  margin-bottom: 24px;
}

.goal-progress-bar {
  width: 100%;
  height: 10px;
  background: var(--border-color);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin: 12px 0 8px 0;
}

.goal-progress-fill {
  height: 100%;
  background: var(--gradient-emerald-teal);
  border-radius: var(--radius-full);
  transition: width 0.6s ease;
}

/* Subject Roadmap Visual Tree */
.roadmap-container {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 32px;
}

.roadmap-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
}

.subject-tabs {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding-bottom: 8px;
}

.tab-btn {
  padding: 8px 18px;
  border-radius: var(--radius-full);
  border: 1px solid var(--border-color);
  background: var(--bg-card);
  color: var(--text-muted);
  font-weight: 600;
  font-size: 0.88rem;
  white-space: nowrap;
}

.tab-btn.active {
  background: var(--primary-gradient);
  color: #ffffff;
  border-color: transparent;
  box-shadow: var(--shadow-sm);
}

.roadmap-tree {
  display: flex;
  flex-direction: column;
  gap: 24px;
  position: relative;
  padding-left: 20px;
}

.roadmap-tree::before {
  content: '';
  position: absolute;
  left: 39px;
  top: 30px;
  bottom: 30px;
  width: 4px;
  background: var(--border-color);
  border-radius: 2px;
}

.roadmap-node {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  position: relative;
  z-index: 2;
}

.node-icon-status {
  width: 42px;
  height: 42px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-weight: 700;
  box-shadow: var(--shadow-sm);
  flex-shrink: 0;
  background: var(--text-subtle);
}

.roadmap-node.completed .node-icon-status {
  background: var(--gradient-emerald-teal);
  box-shadow: 0 0 12px rgba(16, 185, 129, 0.4);
}

.roadmap-node.in-progress .node-icon-status {
  background: var(--gradient-purple-pink);
  animation: pulse 2s infinite;
}

.roadmap-node.unlocked .node-icon-status {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  box-shadow: 0 0 12px rgba(37, 99, 235, 0.3);
}

.node-card {
  flex: 1;
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.roadmap-node.completed .node-card {
  border-left: 4px solid var(--color-emerald);
}

.roadmap-node.in-progress .node-card {
  border-left: 4px solid var(--color-purple);
  box-shadow: var(--shadow-md);
}

.roadmap-node.unlocked .node-card {
  border-left: 4px solid #3b82f6;
}

/* Interactive Quiz Engine */
.quiz-container {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 32px;
  max-width: 800px;
  margin: 0 auto;
}

.quiz-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border-color);
}

.quiz-timer {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(245, 158, 11, 0.15);
  color: var(--color-amber);
  font-weight: 700;
  padding: 6px 14px;
  border-radius: var(--radius-full);
}

.question-box {
  margin-bottom: 24px;
}

.question-text {
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 20px;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.option-btn {
  padding: 14px 20px;
  border-radius: var(--radius-md);
  border: 2px solid var(--border-color);
  background: var(--bg-surface);
  color: var(--text-main);
  font-size: 0.95rem;
  font-weight: 600;
  text-align: left;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.option-btn:hover {
  border-color: var(--color-purple);
  background: var(--bg-card-hover);
}

.option-btn.selected {
  border-color: var(--color-purple);
  background: rgba(139, 92, 246, 0.1);
  color: var(--color-purple);
}

.option-btn.correct {
  border-color: var(--color-emerald) !important;
  background: rgba(16, 185, 129, 0.15) !important;
  color: var(--color-emerald) !important;
}

.option-btn.wrong {
  border-color: var(--color-rose) !important;
  background: rgba(244, 63, 94, 0.15) !important;
  color: var(--color-rose) !important;
}

.explanation-banner {
  background: rgba(99, 102, 241, 0.1);
  border-left: 4px solid var(--color-indigo);
  padding: 16px;
  border-radius: var(--radius-sm);
  margin-top: 20px;
  font-size: 0.9rem;
  color: var(--text-main);
}

/* Achievements & Printable Certificates */
.badges-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 20px;
  margin-bottom: 32px;
}

.badge-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 24px 16px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  transition: all var(--transition-fast);
}

.badge-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-colorful);
}

.badge-icon-box {
  width: 64px;
  height: 64px;
  border-radius: var(--radius-full);
  background: var(--gradient-purple-pink);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  margin-bottom: 12px;
  box-shadow: 0 4px 16px rgba(139, 92, 246, 0.4);
}

.badge-card.locked {
  opacity: 0.45;
  filter: grayscale(80%);
}

.badge-title {
  font-weight: 700;
  font-size: 1rem;
  margin-bottom: 4px;
}

.badge-desc {
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* Certificate View Modal / Canvas */
.certificate-preview-card {
  background: #ffffff;
  color: #0f172a;
  border: 16px double var(--primary-500);
  border-radius: var(--radius-md);
  padding: 50px 40px 40px 40px;
  text-align: center;
  position: relative;
  box-shadow: var(--shadow-lg);
}

.cert-header {
  font-family: 'Georgia', 'Times New Roman', serif;
  font-size: 2.6rem;
  font-weight: 700;
  color: #1e293b;
  margin-top: 24px;
  margin-bottom: 12px;
}

.cert-student-name {
  font-family: 'Brush Script MT', 'Dancing Script', 'Georgia', cursive;
  font-size: 2.8rem;
  font-weight: 700;
  color: var(--primary-600);
  border-bottom: 2px solid var(--border-color);
  display: inline-block;
  padding: 0 40px 4px 40px;
  margin: 12px 0 20px 0;
}

.cert-seal {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20px auto 0 auto;
  font-weight: 800;
  box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4);
}

/* Modals Overlay */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
  animation: fadeIn 0.25s ease;
}

.modal-content {
  background: var(--bg-modal);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 750px;
  max-height: 90vh;
  overflow-y: auto;
  padding: 32px;
  position: relative;
  box-shadow: var(--shadow-lg);
}

.btn-close-modal {
  position: absolute;
  top: 20px;
  right: 20px;
  width: 36px;
  height: 36px;
  border-radius: var(--radius-full);
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-close-modal:hover {
  background: var(--bg-card-hover);
  color: var(--text-main);
}

/* Onboarding Assessment Stepper */
.onboarding-wizard {
  text-align: center;
}

.step-options-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin: 24px 0;
}

.vark-option-card {
  background: var(--bg-card);
  border: 2px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 20px;
  cursor: pointer;
  text-align: center;
  transition: all var(--transition-fast);
}

.vark-option-card:hover, .vark-option-card.selected {
  border-color: var(--color-purple);
  background: rgba(139, 92, 246, 0.08);
  transform: translateY(-2px);
}

.vark-icon-circle {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--primary-gradient);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12px auto;
}

/* Admin Table */
.admin-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 16px;
}

.admin-table th, .admin-table td {
  padding: 12px 16px;
  text-align: left;
  border-bottom: 1px solid var(--border-color);
}

.admin-table th {
  background: var(--bg-card);
  font-weight: 700;
  font-size: 0.85rem;
  color: var(--text-muted);
  text-transform: uppercase;
}

/* Keyframe Animations */
@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.98); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(139, 92, 246, 0.6); }
  70% { box-shadow: 0 0 0 14px rgba(139, 92, 246, 0); }
  100% { box-shadow: 0 0 0 0 rgba(139, 92, 246, 0); }
}

/* Responsive Media Queries */
@media (max-width: 992px) {
  .sidebar {
    transform: translateX(-100%);
  }
  .sidebar.open {
    transform: translateX(0);
  }
  .main-wrapper {
    margin-left: 0;
  }
  .section-grid-2-1 {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .page-container {
    padding: 16px;
  }
  .stats-grid {
    grid-template-columns: 1fr;
  }
  .step-options-grid {
    grid-template-columns: 1fr;
  }
}

/* ==========================================================================
   AI CHATBOT FLOATING WIDGET & ASSISTANT STYLES
   ========================================================================== */

@keyframes chatSlideUp {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes pulseGlow {
  0% {
    transform: scale(0.95);
    box-shadow: 0 0 0 0 rgba(190, 24, 93, 0.7);
  }
  70% {
    transform: scale(1);
    box-shadow: 0 0 0 14px rgba(190, 24, 93, 0);
  }
  100% {
    transform: scale(0.95);
    box-shadow: 0 0 0 0 rgba(190, 24, 93, 0);
  }
}

@keyframes floatBadge {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}

@keyframes typingBounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
  40% { transform: translateY(-6px); opacity: 1; }
}

/* Floating Action Button (Bottom Right) */
.ai-chatbot-fab-wrapper {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 9999;
  display: flex;
  align-items: center;
  gap: 12px;
}

.ai-fab-tooltip {
  background: var(--bg-surface);
  color: var(--text-main);
  border: 1px solid var(--border-color);
  padding: 8px 14px;
  border-radius: var(--radius-full);
  font-size: 0.82rem;
  font-weight: 700;
  box-shadow: var(--shadow-md);
  cursor: pointer;
  animation: floatBadge 3s ease-in-out infinite;
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
  user-select: none;
  transition: all var(--transition-fast);
}

.ai-fab-tooltip:hover {
  border-color: var(--color-indigo);
  transform: scale(1.04);
}

.ai-chatbot-fab {
  width: 60px;
  height: 60px;
  border-radius: var(--radius-full);
  background: var(--primary-gradient);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 28px rgba(190, 24, 93, 0.45);
  position: relative;
  transition: all var(--transition-bounce);
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.ai-chatbot-fab:hover {
  transform: scale(1.08) rotate(3deg);
  box-shadow: 0 14px 34px rgba(190, 24, 93, 0.6);
}

.ai-chatbot-fab:active {
  transform: scale(0.94);
}

.fab-avatar-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-icon {
  width: 28px;
  height: 28px;
}

.fab-pulse-ring {
  position: absolute;
  top: -4px;
  left: -4px;
  right: -4px;
  bottom: -4px;
  border-radius: var(--radius-full);
  animation: pulseGlow 2.4s infinite;
  pointer-events: none;
}

.fab-sparkle-badge {
  position: absolute;
  top: -14px;
  right: -14px;
  font-size: 14px;
  animation: floatBadge 2s ease-in-out infinite;
}

/* Chatbot Floating Window */
.ai-chatbot-window {
  position: fixed;
  bottom: 96px;
  right: 24px;
  width: 420px;
  max-width: calc(100vw - 32px);
  height: 620px;
  max-height: calc(100vh - 120px);
  border-radius: 20px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25), 0 0 0 1px var(--border-highlight);
  animation: chatSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Header */
.ai-chat-header {
  padding: 14px 18px;
  background: var(--bg-navbar);
  border-bottom: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(16px);
}

.ai-chat-header-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ai-chat-avatar {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  background: var(--primary-gradient);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: var(--shadow-sm);
}

.ai-chat-avatar svg {
  width: 22px;
  height: 22px;
}

.online-indicator {
  position: absolute;
  bottom: -2px;
  right: -2px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #10b981;
  border: 2px solid var(--bg-surface);
}

.ai-chat-title {
  font-size: 1rem;
  font-weight: 800;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 6px;
}

.ai-badge-pill {
  font-size: 0.65rem;
  padding: 2px 6px;
  border-radius: var(--radius-full);
  background: rgba(190, 24, 93, 0.15);
  color: var(--color-indigo);
  font-weight: 800;
  text-transform: uppercase;
}

.ai-chat-subtitle {
  font-size: 0.73rem;
  color: var(--text-muted);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 4px;
  max-width: 220px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-chat-header-actions {
  display: flex;
  align-items: center;
  gap: 6px;
}

.ai-header-btn {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  transition: all var(--transition-fast);
}

.ai-header-btn:hover {
  background: var(--bg-card-hover);
  color: var(--text-main);
}

.ai-header-btn.active {
  background: rgba(239, 68, 68, 0.15);
  color: var(--color-rose);
}

.ai-header-btn svg {
  width: 17px;
  height: 17px;
}

/* Messages Container */
.ai-chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  background: var(--bg-page);
  scroll-behavior: smooth;
}

.ai-chat-messages::-webkit-scrollbar {
  width: 6px;
}

.ai-chat-messages::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 4px;
}

/* Message Rows & Bubbles */
.ai-chat-msg-row {
  display: flex;
  gap: 10px;
  max-width: 100%;
}

.ai-chat-msg-row.user-row {
  flex-direction: row-reverse;
  align-self: flex-end;
}

.ai-chat-msg-row.bot-row {
  align-self: flex-start;
}

.msg-avatar {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.msg-avatar.bot-avatar {
  background: var(--primary-gradient);
  color: #ffffff;
  box-shadow: 0 2px 6px rgba(190, 24, 93, 0.3);
}

.msg-avatar.bot-avatar svg {
  width: 16px;
  height: 16px;
}

.msg-avatar.user-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ai-chat-bubble {
  padding: 12px 15px;
  font-size: 0.88rem;
  line-height: 1.55;
  max-width: 86%;
  word-break: break-word;
  position: relative;
}

.user-bubble {
  background: var(--primary-gradient);
  color: #ffffff;
  border-radius: 16px 4px 16px 16px;
  box-shadow: 0 4px 12px rgba(190, 24, 93, 0.25);
}

.bot-bubble {
  background: var(--bg-card);
  color: var(--text-main);
  border: 1px solid var(--border-color);
  border-radius: 4px 16px 16px 16px;
  box-shadow: var(--shadow-sm);
}

.bubble-content h2.ai-chat-heading {
  font-size: 1.08rem;
  font-weight: 800;
  margin: 8px 0 6px 0;
  color: var(--color-indigo);
}

.bubble-content h3.ai-chat-heading {
  font-size: 0.98rem;
  font-weight: 700;
  margin: 8px 0 6px 0;
  color: var(--text-main);
}

.bubble-content h4.ai-chat-heading {
  font-size: 0.92rem;
  font-weight: 700;
  margin: 6px 0 4px 0;
  color: var(--text-main);
}

/* Lists in Markdown */
.ai-chat-list, .ai-chat-ordered-list {
  margin: 6px 0 8px 16px;
  padding: 0;
}

.ai-chat-list-item {
  margin-bottom: 4px;
}

.ai-chat-ordered-item {
  margin-bottom: 4px;
  list-style: none;
}

.ai-chat-ordered-item .list-num {
  font-weight: 700;
  color: var(--color-indigo);
  margin-right: 4px;
}

/* Code Blocks in Chat */
.ai-chat-code-block {
  margin: 10px 0;
  background: #0f172a;
  color: #e2e8f0;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.1);
  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
}

.ai-chat-code-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 10px;
  background: rgba(255, 255, 255, 0.06);
  font-size: 0.7rem;
  font-weight: 700;
  color: #94a3b8;
  letter-spacing: 0.05em;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.ai-chat-copy-code-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  background: rgba(255, 255, 255, 0.12);
  color: #f8fafc;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 0.68rem;
  transition: all var(--transition-fast);
}

.ai-chat-copy-code-btn:hover {
  background: rgba(255, 255, 255, 0.25);
}

.ai-chat-code-block pre {
  padding: 10px;
  margin: 0;
  overflow-x: auto;
  font-size: 0.78rem;
  line-height: 1.45;
}

.ai-chat-inline-code {
  font-family: monospace;
  background: rgba(190, 24, 93, 0.12);
  color: var(--color-indigo);
  padding: 2px 5px;
  border-radius: 4px;
  font-size: 0.82rem;
}

.user-bubble .ai-chat-inline-code {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

/* Math blocks in Chat */
.ai-chat-math-block {
  margin: 8px 0;
  padding: 8px 12px;
  background: var(--bg-surface);
  border-left: 3px solid var(--color-indigo);
  border-radius: 4px;
  font-family: monospace;
  font-size: 0.85rem;
  overflow-x: auto;
  color: var(--text-main);
}

.ai-chat-math-inline {
  font-family: monospace;
  font-weight: 600;
  color: var(--color-indigo);
}

/* Table in Chat */
.ai-chat-table-wrapper {
  overflow-x: auto;
  margin: 10px 0;
}

.ai-chat-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.78rem;
}

.ai-chat-table th, .ai-chat-table td {
  padding: 6px 10px;
  border: 1px solid var(--border-color);
  text-align: left;
}

.ai-chat-table th {
  background: var(--bg-card-hover);
  font-weight: 700;
}

/* Bubble Footer & Actions */
.bubble-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8px;
  padding-top: 6px;
  border-top: 1px solid var(--border-color);
  font-size: 0.7rem;
  color: var(--text-subtle);
}

.user-bubble .bubble-footer {
  border-top-color: rgba(255, 255, 255, 0.25);
  color: rgba(255, 255, 255, 0.8);
}

.bubble-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.bubble-icon-action {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: var(--text-muted);
  font-size: 0.72rem;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 4px;
  transition: all var(--transition-fast);
}

.bubble-icon-action:hover {
  background: var(--bg-card-hover);
  color: var(--color-indigo);
}

.bubble-icon-action svg {
  width: 12px;
  height: 12px;
}

/* Interactive Action Button in Chat */
.ai-chat-action-container {
  margin-top: 10px;
  margin-bottom: 4px;
}

.ai-chat-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--primary-gradient);
  color: #ffffff;
  padding: 8px 16px;
  border-radius: var(--radius-full);
  font-size: 0.82rem;
  font-weight: 700;
  box-shadow: 0 4px 12px rgba(190, 24, 93, 0.3);
  transition: all var(--transition-fast);
}

.ai-chat-action-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(190, 24, 93, 0.45);
}

.ai-chat-action-btn svg {
  width: 15px;
  height: 15px;
}

/* Follow-up Suggestion Chips */
.ai-chat-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 10px;
}

.ai-suggestion-chip {
  background: var(--bg-surface);
  color: var(--text-main);
  border: 1px solid var(--border-color);
  padding: 4px 10px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
  text-align: left;
  transition: all var(--transition-fast);
}

.ai-suggestion-chip:hover {
  border-color: var(--color-indigo);
  background: rgba(190, 24, 93, 0.08);
  color: var(--color-indigo);
  transform: translateY(-1px);
}

/* Typing Indicator Animation */
.typing-bubble {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 10px 14px;
}

.ai-typing-indicator {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.ai-typing-indicator span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--color-indigo);
  animation: typingBounce 1.4s infinite ease-in-out both;
}

.ai-typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
.ai-typing-indicator span:nth-child(2) { animation-delay: -0.16s; }

/* Input Area */
.ai-chat-input-area {
  padding: 12px 14px;
  background: var(--bg-navbar);
  border-top: 1px solid var(--border-color);
  backdrop-filter: blur(16px);
}

.ai-chat-form {
  display: flex;
  align-items: flex-end;
  gap: 8px;
}

.ai-input-wrapper {
  flex: 1;
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  padding-right: 6px;
  transition: border-color var(--transition-fast);
}

.ai-input-wrapper:focus-within {
  border-color: var(--color-indigo);
  box-shadow: 0 0 0 2px rgba(190, 24, 93, 0.15);
}

#ai-chat-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  padding: 10px 12px;
  font-size: 0.85rem;
  color: var(--text-main);
  resize: none;
  max-height: 100px;
  line-height: 1.4;
  font-family: inherit;
}

.ai-input-tool-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  transition: all var(--transition-fast);
}

.ai-input-tool-btn:hover {
  background: var(--bg-card-hover);
  color: var(--color-indigo);
}

.ai-input-tool-btn.listening {
  background: rgba(239, 68, 68, 0.2);
  color: var(--color-rose);
  animation: pulseGlow 1.5s infinite;
}

.ai-input-tool-btn svg {
  width: 17px;
  height: 17px;
}

.ai-chat-send-btn {
  width: 42px;
  height: 42px;
  border-radius: var(--radius-md);
  background: var(--primary-gradient);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(190, 24, 93, 0.35);
  transition: all var(--transition-fast);
}

.ai-chat-send-btn:hover {
  transform: translateY(-2px) scale(1.04);
  box-shadow: 0 6px 16px rgba(190, 24, 93, 0.5);
}

.ai-chat-send-btn:active {
  transform: scale(0.95);
}

.ai-chat-send-btn svg {
  width: 18px;
  height: 18px;
}

/* Mobile Responsiveness for AI Chat */
@media (max-width: 480px) {
  .ai-chatbot-window {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    bottom: 0;
    right: 0;
    border-radius: 0;
    border: none;
  }
}

